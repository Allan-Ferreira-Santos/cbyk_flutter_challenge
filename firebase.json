{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "cbyk-flutter-challenge",
          "appId": "1:869666534879:android:d0f7fe62a0bbbf5b5f806a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "cbyk-flutter-challenge",
          "appId": "1:869666534879:ios:7e87485d5fb7e3765f806a",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "cbyk-flutter-challenge",
          "configurations": {
            "android": "1:869666534879:android:d0f7fe62a0bbbf5b5f806a",
            "ios": "1:869666534879:ios:7e87485d5fb7e3765f806a",
            "web": "1:869666534879:web:8d105d2eb75190345f806a"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
